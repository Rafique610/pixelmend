# GenAI Assignment — environment variable template
# Copy this to .env and fill in actual values.
# NEVER commit .env — it is gitignored.

# -----------------------------------------------------------------------
# Device override (leave empty to auto-detect: CUDA > CPU)
# Options: "cuda", "cpu", "mps"
# -----------------------------------------------------------------------
GENAI_DEVICE=

# -----------------------------------------------------------------------
# Paths (leave empty to use project-root-relative defaults)
# -----------------------------------------------------------------------
GENAI_DATA_DIR=data
GENAI_CHECKPOINTS_DIR=checkpoints
GENAI_ONNX_DIR=models/onnx
GENAI_MANIFESTS_DIR=manifests
GENAI_OPTUNA_DB=optuna/optuna_studies.db
GENAI_RESULTS_DIR=results

# -----------------------------------------------------------------------
# MLflow tracking (local server)
# Default: logs to mlruns/ in project root (no server needed)
# To use a remote server: GENAI_MLFLOW_TRACKING_URI=http://localhost:5000
# -----------------------------------------------------------------------
GENAI_MLFLOW_TRACKING_URI=

# -----------------------------------------------------------------------
# FastAPI backend
# -----------------------------------------------------------------------
GENAI_BACKEND_HOST=0.0.0.0
GENAI_BACKEND_PORT=8000
GENAI_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------
# Training defaults (can be overridden per-task)
# -----------------------------------------------------------------------
GENAI_NUM_WORKERS=2
GENAI_SEED=42
