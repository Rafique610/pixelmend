# =============================================================================
# Gitignore — AI-4009 Generative AI Project
# Maintained side-by-side on every step.
# =============================================================================

# --- Session Memory & Agent Scaffolds ---
.memory/
.agents/

# --- Temporary Archives & PDFs ---
*.zip
*.tar.gz
*.tgz

# --- Datasets (Raw images — download via scripts) ---
data/*
!data/.gitkeep
!data/README.md

# --- Model Checkpoints (Heavy weights — download links provided in README) ---
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/**/README.md
models/**/*.onnx
!models/**/.gitkeep

# --- Optuna Studies Database ---
optuna/*.db
optuna/*.db-shm
optuna/*.db-wal
!optuna/.gitkeep
# Note: JSON export summaries are tracked for evaluation records:
!optuna/*.json

# --- MLflow Local Tracking Directory ---
mlruns/
.mlflow/
mlflow.db*


# --- Python Build, Cache & Environments ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
.uv/

# --- Node & Frontend Build Output ---
node_modules/
dist/
.next/
.nuxt/
*.tsbuildinfo
.eslintcache

# --- Secrets & Local Environment Config ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Docker ---
.docker/

# --- IDEs & OS Metadata ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Test & Coverage Artifacts ---
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
scratch/

# --- Evaluation Output & Large Visual Dumps ---
results/*.png
results/*.jpg
results/*.jpeg
results/**/*.png
results/**/*.jpg
results/**/*.jpeg
!results/**/.gitkeep
!results/.gitkeep
# Quantitative JSON metrics are preserved in Git:
!results/**/*.json
