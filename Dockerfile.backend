# ==============================================================================
# PixelMend Backend Dockerfile (100% CPU-Only, Universal Cross-Platform Architecture)
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Virtual Environment with Pure CPU Dependencies
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1

# Install uv package manager from official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /build

# Create isolated Python virtual environment
RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:$PATH"

# Install pure CPU PyTorch & torchvision (zero CUDA/GPU drivers required)
RUN uv pip install --no-cache \
    "torch>=2.1.0" \
    "torchvision>=0.16.0" \
    --index-url https://download.pytorch.org/whl/cpu

# Install FastAPI and ONNX Runtime CPU inference dependencies
RUN uv pip install --no-cache \
    "fastapi>=0.109.0" \
    "uvicorn[standard]>=0.27.0" \
    "python-multipart>=0.0.9" \
    "pydantic>=2.5.0" \
    "pydantic-settings>=2.2.0" \
    "onnxruntime>=1.16.0" \
    "numpy>=1.24.0" \
    "Pillow>=10.0.0" \
    "scipy>=1.11.0" \
    "matplotlib>=3.8.0"

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM python:3.11-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONPATH="/app" \
    GENAI_HOST="0.0.0.0" \
    GENAI_PORT="8000" \
    GENAI_LOG_LEVEL="info" \
    GENAI_PREFER_CUDA="false" \
    GENAI_MODELS_DIR="/app/models/onnx"

# Security: create non-root application user
RUN useradd -m -u 1000 appuser && \
    mkdir -p /app/models/onnx && \
    chown -R appuser:appuser /app

# Copy isolated virtualenv from builder
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

# Copy backend application source and shared modules
COPY --chown=appuser:appuser src/__init__.py /app/src/__init__.py
COPY --chown=appuser:appuser src/app/__init__.py /app/src/app/__init__.py
COPY --chown=appuser:appuser src/app/backend /app/src/app/backend
COPY --chown=appuser:appuser src/shared /app/src/shared

USER appuser

EXPOSE 8000

# Health check verifies GET /health returns 200 with all ONNX models loaded
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

ENTRYPOINT ["uvicorn", "src.app.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
